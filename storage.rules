rules_version = '2';

// قواعد Firebase Storage.
//
// ===================== لماذا هذا الملف موجود =====================
//
// مشروع Firebase يحمل حزمة تخزين مُهيّأة (`storageBucket` في
// `lib/firebase_options.dart`)، لكن المستودع لم يكن يحوي أي قواعد لها ولا
// مدخلاً لها في `firebase.json`. أي أن حالة الحزمة المنشورة كانت خارج
// إدارة المستودع بالكامل: ما يحكمها هو ما ضُبط يدوياً في وحدة التحكم، وهو
// افتراضاً «أي مستخدم مسجَّل يقرأ ويكتب» في المشاريع التي مضى على
// إنشائها وقت.
//
// والتطبيق **لا يستعمل التخزين إطلاقاً**: لا اعتمادية `firebase_storage`
// في `pubspec.yaml`، ولا مسار رفع أو تنزيل واحد في `lib/`. فالحالة
// الصحيحة الوحيدة هي المنع الكامل.
//
// منع كامل لا «مصادقة مطلوبة»: حزمة مفتوحة لأي مستخدم مسجَّل في تطبيق
// التسجيل فيه مجاني هي استضافة ملفات مجانية باسم نطاق المشروع — تُستعمل
// لبثّ محتوى من مصدر موثوق ظاهرياً، وتُحمَّل تكلفتها على المشروع.
//
// حين يحتاج التطبيق التخزين فعلاً (صورة طبيب، مرفق وصفة) تُفتح مسارات
// محدّدة هنا بشروط ملكية صريحة — لا بفتح الجذر.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
