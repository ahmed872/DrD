rules_version = '2';

// قواعد أمان Firestore لتطبيق DrD.
//
// قبل هذا الملف لم تكن هناك قواعد في المستودع إطلاقاً — أي أن قاعدة البيانات
// كانت تعمل بما ضُبط يدوياً في وحدة تحكم Firebase، وغالباً بوضع الاختبار
// المفتوح. التطبيق يخزّن أسماء مرضى وأرقام هواتف وتواريخ ميلاد وأعراضاً
// وتقييمات صحية؛ هذه بيانات طبية، وفتحها للقراءة العامة مشكلة حقيقية.
//
// المبدأ العام: كل شيء ممنوع إلا ما سُمح به صراحةً.
//
// ===================== المرحلة صفر: الإغلاق الأمني =====================
//
// راجع `docs/SECURITY.md` و`scripts/README.md`. ما تغيّر في هذه المرحلة:
//
//   1. إنشاء حساب بدور `doctor` من العميل صار مستحيلاً — الترقية عبر
//      Admin SDK فقط (`scripts/promote_to_doctor.js`).
//   2. الطبيب غير الموثَّق (`isVerified != true`) لا يمكن الحجز عنده.
//   3. لا يُكتب موعد إلا ومعه قفل خانة صالح في نفس المعاملة.
//   4. سعة الخانة تُقارَن بإعدادات الطبيب الحقيقية، فلا يرفعها العميل.
//   5. لا يُنقص عدّاد خانة إلا صاحب الحجز أو الطبيب.
//   6. المريض لا يعدّل في موعده إلا الإلغاء؛ والطبيب الحالة والملاحظة فقط.
//   7. لا مراجعة إلا من مريض له موعد مكتمل فعلاً، وواحدة لكل موعد.
//   8. مجموعة `otps` حُذفت بالكامل (كانت مفتوحة للكتابة بلا مصادقة).

service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== دوال مساعدة =====================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // الحقول التي تغيّرت فعلاً في هذا الطلب.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ===================== مفتاح إقفال الحجز المباشر =====================

    // المرحلة 1أ نقلت قرار الحجز إلى الدالة `bookAppointment`، والدوال
    // السحابية تعمل بـ Admin SDK فتتجاوز هذه القواعد. لكن **لا يجوز** إقفال
    // المسار القديم قبل أن يصبح العميل المنشور فعلاً يستخدم الدالة: كل نسخة
    // قديمة مثبَّتة على هاتف مريض ستفقد القدرة على الحجز لحظة الإقفال.
    //
    // ولذلك الإقفال خطوة نشر مستقلة: اقلب هذه القيمة إلى `false` بعد التحقق
    // (راجع `scripts/README.md` — ترتيب نشر المرحلة 1أ).
    //
    // ما يتأثر بها: إنشاء خانة، وزيادة عدّادها، وإنشاء موعد. الإلغاء وإدارة
    // الطبيب لخاناته تبقى من العميل في هذه المرحلة.
    //
    // الحالتان مغطّاتان بالاختبارات: `rules.test.js` يشغّل نفس الملف مرتين،
    // مرة كما هو ومرة بالقيمة مقلوبة.
    function clientDirectBookingEnabled() { return true; }

    // المرحلة 1ب نقلت الإلغاء أيضاً إلى الخادم (`cancelAppointment`) —
    // معه المهلة، وتحقّق الحالة، وربط تحرير الخانة بنفس المعاملة. **نفس
    // انضباط النشر بالضبط**: هذا المفتاح يبقى `true` حتى يُتحقَّق أن العميل
    // المنشور يلغي عبر الدالة لا مباشرة، ثم يُقلب — لا قبل ذلك.
    //
    // ما يتأثر به: تحديث حالة الموعد إلى `Cancelled` من المريض مباشرة،
    // ونقص عدّاد الخانة المقابل. إعادة الجدولة (`rescheduleAppointment`)
    // لم يكن لها مسار عميل مباشر إطلاقاً — فلا حاجة لمفتاح توافقي لها.
    function clientDirectCancelEnabled() { return true; }

    // ===================== الطبيب القابل للحجز =====================

    // الحجز لا يُقبل إلا عند طبيب **موثَّق**.
    //
    // بدون هذا الشرط، أي حساب يُنشأ بدور طبيب (أو يُرقّى بالخطأ) يصبح فوراً
    // قابلاً لاستقبال مرضى حقيقيين ببياناتهم الصحية. التوثيق قرار إداري
    // يُكتب من Admin SDK، ولا يستطيع الطبيب منحه لنفسه (انظر
    // `keepsProtectedFields`).
    //
    // ملاحظة هجرة: الأطباء الموجودون قبل هذه المرحلة ليس لديهم الحقل، ولذلك
    // يجب تشغيل `scripts/grandfather_doctors.js` **قبل** نشر هذه القواعد،
    // وإلا توقّف الحجز عند كل طبيب قائم.
    function isBookableDoctor(doctorId) {
      let d = userData(doctorId);
      return d.role == 'doctor' && d.get('isVerified', false) == true;
    }

    // السعة المسموح بها لخانة هذا الطبيب، كما يعلنها مستنده هو — لا كما
    // يرسلها العميل.
    //
    // القيم الافتراضية مطابقة لما تستخدمه الواجهة عند غياب الحقل
    // (`patient_booking_screen.dart`)، حتى لا يفشل الحجز عند طبيب لم يكمل
    // إعداداته بعد.
    function allowedCapacity(doctorId) {
      let d = userData(doctorId);
      return d.get('bookingSystemType', 'Individual') == 'Grouped'
        ? d.get('maxPatientsPerSlot', 4)
        : 1;
    }

    // ===================== المستخدمون =====================

    match /users/{userId} {
      // تحديث متوسط تقييم الطبيب بعد إضافة مراجعة.
      //
      // القاعدة الحالية في مشروعك هي:
      //   hasOnly(['rating', 'reviews'])
      // وهي تسمح لأي مستخدم مسجَّل بكتابة **أي قيمة** في تقييم أي طبيب —
      // فيستطيع شخص أن يضع لطبيب منافس صفراً، أو يرفع تقييم نفسه إلى 5،
      // أو يكتب `reviews: 99999`، كل ذلك بطلب واحد من العميل.
      //
      // الشروط أدناه تُبقي الميزة تعمل لكن تحصرها في زيادة مراجعة واحدة
      // بقيمة ضمن النطاق المسموح، ولطبيب غير صاحب الطلب.
      //
      // ملاحظة: الحل الأمثل نقل الحساب إلى Cloud Function تُشغَّل عند الكتابة
      // في `reviews`، ثم منع تعديل هذين الحقلين من العميل نهائياً. حتى ذلك
      // الحين يبقى تحريك المتوسط بمقدار مراجعة واحدة ممكناً — وهو خطر
      // مقبول مؤقتاً بعد أن صارت المراجعة نفسها تتطلب موعداً مكتملاً.
      function isReviewAggregateUpdate() {
        return isSignedIn()
          && request.resource.data.diff(resource.data)
               .affectedKeys().hasOnly(['rating', 'reviews'])
          && request.resource.data.rating is number
          && request.resource.data.rating >= 0
          && request.resource.data.rating <= 5
          && request.resource.data.reviews == resource.data.get('reviews', 0) + 1
          && resource.data.role == 'doctor'
          && request.auth.uid != userId;
      }

      // الحقول التي لا يجوز للمستخدم تغييرها بنفسه.
      //
      // - `role`: بدونه يستطيع أي مريض ترقية نفسه إلى طبيب من العميل مباشرة،
      //   فيرى كل مواعيد العيادة وبيانات مرضاها.
      // - `isVerified`: وإلا وثّق الطبيب نفسه وسقطت قيمة التوثيق كلها.
      // - `email`: مفتاح الربط مع Firebase Auth ومع `phone_index`؛ تغييره من
      //   العميل يفصل الحساب عن وسيلة دخوله.
      // - `rating` و`reviews`: حقول مجمَّعة تُحسب من مراجعات المرضى. لو تُركت
      //   لصاحب الحساب لاستطاع الطبيب أن يكتب لنفسه 5 نجوم و500 مراجعة.
      //   تحديثها الشرعي يمرّ عبر `isReviewAggregateUpdate()` وحدها.
      //
      // `phone` غير محمي هنا عمداً: شاشة إعدادات الطبيب تسمح بتعديل الرقم،
      // ومنعه كان سيكسر ميزة قائمة. (مزامنة `phone_index` مسؤولية التطبيق.)
      function keepsProtectedFields() {
        return request.resource.data.role == resource.data.role
            && request.resource.data.get('isVerified', false)
               == resource.data.get('isVerified', false)
            && request.resource.data.get('email', '')
               == resource.data.get('email', '')
            && request.resource.data.get('rating', 0)
               == resource.data.get('rating', 0)
            && request.resource.data.get('reviews', 0)
               == resource.data.get('reviews', 0);
      }

      // القراءة: صاحب الحساب يقرأ مستنده. الأطباء بحاجة لأن يكونوا مرئيين
      // للمرضى حتى يمكن حجز المواعيد، ولذلك يُسمح لأي مستخدم مسجَّل بقراءة
      // مستندات الأطباء فقط — لا مستندات المرضى.
      allow read: if isUser(userId)
                  || (isSignedIn() && resource.data.role == 'doctor');

      // الإنشاء: عند التسجيل فقط، وبمعرّف يطابق حساب المصادقة، **وبدور
      // مريض حصراً**.
      //
      // كانت القاعدة تقبل `role in ['doctor', 'patient']`، وشاشة التسجيل
      // تعرض الخيارين للجميع — أي أن أي شخص يسجّل نفسه طبيباً بضغطة زر،
      // فيظهر في قائمة الأطباء ويستقبل حجوزات ويقرأ أعراض المرضى.
      //
      // حسابات الأطباء تُنشأ الآن من Admin SDK وحده:
      //   node scripts/promote_to_doctor.js --uid=<uid> --apply
      allow create: if isUser(userId)
                    && request.resource.data.role == 'patient'
                    && request.resource.data.get('isVerified', false) == false;

      allow update: if (isUser(userId) && keepsProtectedFields())
                    || isReviewAggregateUpdate();

      // الحذف ممنوع من العميل — يمر عبر Cloud Function حتى تُنظَّف
      // البيانات المرتبطة (المواعيد، الفهرس، التقييمات) معاً.
      allow delete: if false;
    }

    // ===================== فهرس أرقام الجوال =====================

    // يحتوي على الحد الأدنى المطلوب لتسجيل الدخول بالرقم: البريد والمعرّف.
    // القراءة مفتوحة لأنها تحدث *قبل* المصادقة بالضرورة، لكن معرّف المستند هو
    // رقم الجوال نفسه — فلا يمكن تصفّح المجموعة أو استخراج قائمة بها، ولا بد
    // من معرفة الرقم مسبقاً للوصول لأي مدخل.
    match /phone_index/{phone} {
      // المدخل يجب أن يشير إلى بريد صاحب الطلب نفسه، لا إلى بريد يختاره.
      // بدون هذا الشرط يستطيع مستخدم كتابة مدخل يوجّه رقماً إلى بريد ثالث.
      function pointsToCaller() {
        return request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email;
      }

      allow get: if true;
      allow list: if false;      // منع سحب الفهرس كاملاً.

      allow create: if isSignedIn()
                    && pointsToCaller()
                    && request.resource.data.keys()
                         .hasOnly(['uid', 'email', 'createdAt']);

      // التعديل لصاحب المدخل القائم فقط — الشرط على `resource` وليس
      // `request.resource`.
      //
      // الفرق ليس شكلياً: لو كان الشرط على `request.resource` لاستطاع أي
      // مستخدم أن يكتب فوق مدخل رقم شخص آخر ويوجّهه لبريده هو، فيمنع صاحب
      // الرقم الحقيقي من تسجيل الدخول (تعطيل حساب).
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && pointsToCaller();

      allow delete: if false;
    }

    // ===================== أقفال الخانات الزمنية =====================

    // هذه المجموعة هي ما يمنع الحجز المزدوج فعلياً.
    //
    // لا يكفي أن يتحقق التطبيق من الامتلاء، لأن أي عميل معدَّل يستطيع تخطّي
    // ذلك الفحص. القواعد هنا تفرض الشرط على الخادم: العدّاد يزيد بواحد فقط،
    // ولا يتجاوز السعة، والسعة نفسها لا تُغيَّر بعد إنشاء الخانة.
    match /slots/{slotId} {
      // معرّف الخانة ليس اسماً حراً — هو دالة في (الطبيب، التاريخ، الوقت).
      //
      // بدون هذا الشرط يستطيع عميل معدَّل إنشاء خانة بمعرّف عشوائي تحمل نفس
      // بيانات خانة محجوزة، ثم يعلّق عليها موعداً — فيعود الحجز المزدوج من
      // باب خلفي رغم سلامة المعاملة الذرّية. الصيغة مطابقة لـ
      // `SlotId.forSlot` في `lib/core/utils/slot_id.dart`.
      function idMatchesFields() {
        return slotId == request.resource.data.doctorId + '_'
             + request.resource.data.appointmentDate + '_'
             + request.resource.data.startTime.replace(':', '-');
      }

      function validDateTimeFormat() {
        return request.resource.data.appointmentDate is string
            && request.resource.data.appointmentDate.matches('\\d{4}-\\d{2}-\\d{2}')
            && request.resource.data.startTime is string
            && request.resource.data.startTime.matches('\\d{2}:\\d{2}');
      }

      allow read: if isSignedIn();

      allow create: if clientDirectBookingEnabled()
                    && isSignedIn()
                    && request.resource.data.bookedCount == 1
                    && request.resource.data.patientIds.size() == 1
                    && request.resource.data.patientIds[0] == request.auth.uid
                    && request.resource.data.doctorId is string
                    && validDateTimeFormat()
                    && idMatchesFields()
                    && isBookableDoctor(request.resource.data.doctorId)
                    // السعة تُملى من مستند الطبيب، لا من العميل. كانت
                    // القاعدة تقبل أي `capacity >= 1`، أي أن أول من يحجز
                    // خانة يستطيع أن يجعل سعتها 999 ويُغرق عيادة الطبيب.
                    && request.resource.data.capacity
                       == allowedCapacity(request.resource.data.doctorId);

      allow update: if isSignedIn()
                    && unchanged('capacity')
                    && unchanged('doctorId')
                    && unchanged('appointmentDate')
                    && unchanged('startTime')
                    && (
                      // حجز: زيادة بواحد دون تجاوز السعة، ويضيف صاحب الطلب
                      // نفسه فقط — لا يحذف غيره ولا يضيف أحداً سواه.
                      (
                        clientDirectBookingEnabled()
                        && request.resource.data.bookedCount == resource.data.bookedCount + 1
                        && request.resource.data.bookedCount <= resource.data.capacity
                        && !(request.auth.uid in resource.data.patientIds)
                        && request.resource.data.patientIds.hasAll([request.auth.uid])
                        && request.resource.data.patientIds.hasOnly(
                             resource.data.patientIds.concat([request.auth.uid]))
                      )
                      // إلغاء: نقص بواحد، ولا يقل عن الصفر، **ولصاحب الحجز
                      // وحده**.
                      //
                      // كانت هذه الفقرة بلا أي تحقق من الهوية: أي مستخدم
                      // مسجَّل يستطيع إنقاص عدّاد أي خانة، فتبدو متاحة
                      // ويُحجز فوقها، أو يُحرم صاحبها من مكانه.
                      //
                      // الشرطان الأخيران يجعلان القائمة الجديدة **مساوية**
                      // للقديمة ناقص صاحب الطلب: لا يضيف أحداً، ولا يشطب
                      // مريضاً آخر من خانة مجموعة ليُخلي له مكاناً.
                      || (
                        clientDirectCancelEnabled()
                        && request.resource.data.bookedCount == resource.data.bookedCount - 1
                        && request.resource.data.bookedCount >= 0
                        && request.auth.uid in resource.data.patientIds
                        && !(request.auth.uid in request.resource.data.patientIds)
                        && resource.data.patientIds.hasAll(
                             request.resource.data.patientIds)
                        && request.resource.data.patientIds.hasAll(
                             resource.data.patientIds.removeAll([request.auth.uid]))
                      )
                      // الطبيب يدير خانات عيادته بحرية.
                      || isUser(resource.data.doctorId)
                    );

      allow delete: if isUser(resource.data.doctorId);
    }

    // ===================== المواعيد =====================

    match /appointments/{appointmentId} {
      function isPatientOwner() {
        return isUser(resource.data.patientId);
      }

      function isDoctorOwner() {
        return isUser(resource.data.doctorId);
      }

      // الموعد لا يقوم بذاته: لا بد أن يقابله قفل خانة يحمل نفس الطبيب ونفس
      // التاريخ ونفس الوقت، ويحتوي صاحب الطلب.
      //
      // `getAfter` وليس `get`: القفل والموعد يُكتبان في **نفس المعاملة**
      // (`BookingService.book`)، فحالة الخانة قبل المعاملة قد تكون غير
      // موجودة أصلاً عند أول حجز. `getAfter` تقرأ الحالة بعد اكتمال
      // المعاملة، وهي الأداة المخصّصة لهذا بالضبط.
      //
      // بدون هذا الشرط كانت قاعدة الإنشاء تقبل أي مستند موعد بحالة `Booked`
      // دون أي علاقة بالخانات — أي أن ضمان عدم الحجز المزدوج كان قابلاً
      // للتخطي بكتابة مباشرة من عميل معدَّل، والطبيب يرى الموعد في جدوله
      // لأن الجدول يُقرأ من `appointments` لا من `slots`.
      function backedBySlot() {
        let slot = getAfter(
          /databases/$(database)/documents/slots/$(request.resource.data.slotId)
        ).data;
        return slot.doctorId == request.resource.data.doctorId
            && slot.appointmentDate == request.resource.data.appointmentDate
            && slot.startTime == request.resource.data.startTime
            && slot.patientIds.hasAll([request.auth.uid])
            && slot.bookedCount <= slot.capacity;
      }

      // المريض يرى مواعيده، والطبيب يرى المواعيد المحجوزة عنده فقط.
      allow read: if isPatientOwner() || isDoctorOwner();

      // الحجز: المريض يكتب باسمه هو، بحالة ابتدائية `Booked` فقط.
      // منع تعيين حالة أخرى يمنع مريضاً من تسجيل نفسه "مكتمل" لتفادي رسوم
      // أو للتلاعب بإحصاءات الطبيب.
      //
      // معرّف المستند مقيَّد بـ `{slotId}__{patientId}` (مطابق لـ
      // `SlotId.forAppointment`) حتى لا يستطيع مريض تعليق عدة مستندات مواعيد
      // على قفل واحد بمعرّفات عشوائية.
      allow create: if clientDirectBookingEnabled()
                    && isUser(request.resource.data.patientId)
                    && request.resource.data.status == 'Booked'
                    && request.resource.data.doctorId is string
                    && request.resource.data.appointmentDate is string
                    && request.resource.data.startTime is string
                    && request.resource.data.slotId is string
                    && appointmentId
                       == request.resource.data.slotId + '__' + request.auth.uid
                    && isBookableDoctor(request.resource.data.doctorId)
                    && backedBySlot();

      // التحديث مقسوم حسب الدور.
      //
      // كانت قاعدة واحدة تسمح للطرفين بتغيير **كل شيء** عدا الطبيب والمريض
      // والتاريخ والوقت. عملياً كان المريض يستطيع أن يعلّم موعده `Completed`،
      // أو يصفّر `price`، أو يكتب فوق `notes` — وهي الملاحظة الطبية التي
      // يكتبها الطبيب، أي تعديل سجل طبي.

      // المريض: الإلغاء وحده، وفقط عبر المسار المباشر القديم.
      //
      // المرحلة 1ب نقلت الإلغاء إلى `cancelAppointment` (تحقّق من الحالة
      // والمهلة، وتحرير الخانة في نفس المعاملة). الدالة تعمل بـ Admin SDK
      // فتتجاوز هذه القاعدة أصلاً؛ القاعدة هنا للتوافق مع نسخ تطبيق قديمة
      // لم تُحدَّث بعد — وتُقفَل بعد التحقق، بنفس انضباط `clientDirectBookingEnabled()`.
      allow update: if isPatientOwner()
                    && clientDirectCancelEnabled()
                    && changedKeys().hasOnly(['status', 'cancelledAt'])
                    && request.resource.data.status == 'Cancelled';

      // الطبيب: الحالة والملاحظة الطبية.
      //
      // `cancelledBy` مضافة للمرحلة 1ب: `BookingService.cancelAsDoctor`
      // تكتبها لتمييز إلغاء الطبيب عن إلغاء المريض في السجل (راجع تعليق
      // تلك الدالة). حقل تصنيف لا بيانات حسّاسة، ولا يفتح شيئاً لم يكن
      // الطبيب يملكه أصلاً — فهو أصلاً يملك تغيير `status` إلى `Cancelled`.
      allow update: if isDoctorOwner()
                    && changedKeys().hasOnly(
                         ['status', 'notes', 'cancelledAt', 'cancelledBy',
                          'completedAt', 'updatedAt'])
                    && (
                      !('status' in changedKeys())
                      || request.resource.data.status in
                         ['Booked', 'Completed', 'Cancelled', 'NoShow',
                          'PendingConfirmation']
                    );

      // لا حذف — الإلغاء يتم بتغيير الحالة، حتى يبقى سجل العيادة كاملاً.
      allow delete: if false;
    }

    // ===================== التقييمات التفصيلية =====================

    // مجموعة `ratings` تحمل تقييمين مختلفين تماماً في الحساسية:
    //   - `patient_to_doctor`: تقييم المريض لجودة الخدمة.
    //   - `doctor_to_patient`: تقييم الطبيب للحالة الصحية للمريض — **بيانات
    //     طبية**، لا يجوز أن يقرأها أحد غير المريض والطبيب الذي كتبها.
    //
    // الحقول هنا `fromUserId` و`toUserId` و`ratingType` مطابقةً لـ
    // `lib/data/models/rating_model.dart`.
    match /ratings/{ratingId} {
      allow read: if isSignedIn() && (
                    isUser(resource.data.fromUserId)
                    || isUser(resource.data.toUserId)
                  );

      // الكاتب لا يستطيع انتحال شخصية غيره.
      allow create: if isSignedIn()
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.ratingType in
                       ['doctor_to_patient', 'patient_to_doctor'];

      allow update: if isSignedIn()
                    && isUser(resource.data.fromUserId)
                    && unchanged('fromUserId')
                    && unchanged('toUserId');

      allow delete: if isSignedIn() && isUser(resource.data.fromUserId);
    }

    // ===================== مراجعات الأطباء العلنية =====================

    // مجموعة منفصلة يكتبها المريض من شاشة "مواعيدي" (نجوم + تعليق).
    // القراءة متاحة لكل مستخدم مسجَّل لأنها جزء من اختيار الطبيب.
    match /reviews/{reviewId} {
      // المراجعة تشهد على زيارة حدثت فعلاً.
      //
      // كانت القاعدة تقبل أي مراجعة من أي حساب مسجَّل بلا حد ولا تكرار —
      // فيستطيع منافس واحد إنزال تقييم طبيب إلى الصفر في دقائق.
      //
      // `status.lower()` يقبل الصيغ القديمة (`completed`, `done`) تماشياً مع
      // `AppointmentStatus._legacyAliases`، فلا تُحرم المواعيد القديمة من
      // التقييم.
      function hasCompletedVisit(appointmentId, doctorId) {
        let a = get(
          /databases/$(database)/documents/appointments/$(appointmentId)
        ).data;
        return a.patientId == request.auth.uid
            && a.doctorId == doctorId
            && a.status is string
            && a.status.lower() in ['completed', 'done'];
      }

      allow read: if isSignedIn();

      // معرّف المستند هو معرّف الموعد نفسه، فلا يمكن أن تُكتب مراجعتان
      // لموعد واحد: المحاولة الثانية تصبح تحديثاً يخضع لقاعدة التحديث أدناه.
      allow create: if isSignedIn()
                    && request.resource.data.patientId == request.auth.uid
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.appointmentId is string
                    && reviewId == request.resource.data.appointmentId
                    && hasCompletedVisit(reviewId,
                                         request.resource.data.doctorId);

      // تعديل المراجعة لصاحبها وحده، وبلا مساس بهوية الموعد أو الطبيب.
      // `createdAt` و`patientName` مسموحان لأن إعادة الإرسال من الشاشة تكتب
      // المستند كاملاً؛ الحقول الحاسمة (المريض، الطبيب، الموعد) مقفلة.
      allow update: if isSignedIn()
                    && isUser(resource.data.patientId)
                    && changedKeys().hasOnly(
                         ['rating', 'comment', 'createdAt', 'updatedAt',
                          'patientName'])
                    && request.resource.data.patientId == resource.data.patientId
                    && request.resource.data.doctorId == resource.data.doctorId
                    && request.resource.data.appointmentId
                       == resource.data.appointmentId
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;

      allow delete: if isSignedIn() && isUser(resource.data.patientId);
    }

    // ===================== الإشعارات =====================

    match /notifications/{notificationId} {
      // المرسَل إليه فقط. الحقول الثلاثة تغطي الصيغ المستخدمة في التطبيق
      // وفي Cloud Functions.
      function isRecipient() {
        return isUser(resource.data.get('userId', ''))
            || isUser(resource.data.get('patientId', ''))
            || isUser(resource.data.get('doctorId', ''));
      }

      allow read: if isRecipient();

      // الإنشاء من الخادم فقط (Cloud Functions تتجاوز هذه القواعد).
      // لولا ذلك لاستطاع أي مستخدم إرسال إشعارات باسم العيادة.
      allow create: if false;

      // للمستلم أن يعلّمها كمقروءة، لا أكثر.
      allow update: if isRecipient()
                    && request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['read']);

      allow delete: if isRecipient();
    }

    // ===================== الافتراضي =====================

    // أي مجموعة لم تُذكر أعلاه مغلقة تماماً — ومنها `otps` التي حُذفت في
    // المرحلة صفر: كانت `allow create: if true` بلا مصادقة، ودالة سحابية
    // ترسل بريداً إلى عنوان مأخوذ من معرّف المستند، أي مرحّل بريد مفتوح
    // باسم المشروع. المسار لم يكن مستخدماً في التطبيق أصلاً.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
