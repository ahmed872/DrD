rules_version = '2';

// قواعد أمان Firestore لتطبيق DrD.
//
// قبل هذا الملف لم تكن هناك قواعد في المستودع إطلاقاً — أي أن قاعدة البيانات
// كانت تعمل بما ضُبط يدوياً في وحدة تحكم Firebase، وغالباً بوضع الاختبار
// المفتوح. التطبيق يخزّن أسماء مرضى وأرقام هواتف وتواريخ ميلاد وأعراضاً
// وتقييمات صحية؛ هذه بيانات طبية، وفتحها للقراءة العامة مشكلة حقيقية.
//
// المبدأ العام: كل شيء ممنوع إلا ما سُمح به صراحةً.
//
// ===================== المرحلة صفر: الإغلاق الأمني =====================
//
// راجع `docs/SECURITY.md` و`scripts/README.md`. ما تغيّر في هذه المرحلة:
//
//   1. إنشاء حساب بدور `doctor` من العميل صار مستحيلاً — الترقية عبر
//      Admin SDK فقط (`scripts/promote_to_doctor.js`).
//   2. الطبيب غير الموثَّق (`isVerified != true`) لا يمكن الحجز عنده.
//   3. لا يُكتب موعد إلا ومعه قفل خانة صالح في نفس المعاملة.
//   4. سعة الخانة تُقارَن بإعدادات الطبيب الحقيقية، فلا يرفعها العميل.
//   5. لا يُنقص عدّاد خانة إلا صاحب الحجز أو الطبيب.
//   6. المريض لا يعدّل في موعده إلا الإلغاء؛ والطبيب الحالة والملاحظة فقط.
//   7. لا مراجعة إلا من مريض له موعد مكتمل فعلاً، وواحدة لكل موعد.
//   8. مجموعة `otps` حُذفت بالكامل (كانت مفتوحة للكتابة بلا مصادقة).

service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== دوال مساعدة =====================

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // المرحلة 2: صلاحية الإدارة.
    //
    // `admin` هنا Custom Claim موقَّع داخل رمز Firebase Auth
    // (`request.auth.token.admin`) — لا حقل Firestore. يُكتب حصراً بـ
    // Admin SDK عبر `scripts/create_admin.js`؛ لا يوجد أي مسار عميل يكتبه
    // أو يقرأه كحقيقة. مصدر الثقة توقيع Firebase نفسه، لا قاعدة البيانات.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // الحقول التي تغيّرت فعلاً في هذا الطلب.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ===================== مفتاح إقفال الحجز المباشر =====================

    // المرحلة 1أ نقلت قرار الحجز إلى الدالة `bookAppointment`، والدوال
    // السحابية تعمل بـ Admin SDK فتتجاوز هذه القواعد. لكن **لا يجوز** إقفال
    // المسار القديم قبل أن يصبح العميل المنشور فعلاً يستخدم الدالة: كل نسخة
    // قديمة مثبَّتة على هاتف مريض ستفقد القدرة على الحجز لحظة الإقفال.
    //
    // ولذلك الإقفال خطوة نشر مستقلة: اقلب هذه القيمة إلى `false` بعد التحقق
    // (راجع `scripts/README.md` — ترتيب نشر المرحلة 1أ).
    //
    // ما يتأثر بها: إنشاء خانة، وزيادة عدّادها، وإنشاء موعد. الإلغاء وإدارة
    // الطبيب لخاناته تبقى من العميل في هذه المرحلة.
    //
    // الحالتان مغطّاتان بالاختبارات: `rules.test.js` يشغّل نفس الملف مرتين،
    // مرة كما هو ومرة بالقيمة مقلوبة.
    function clientDirectBookingEnabled() { return true; }

    // المرحلة 1ب نقلت الإلغاء أيضاً إلى الخادم (`cancelAppointment`) —
    // معه المهلة، وتحقّق الحالة، وربط تحرير الخانة بنفس المعاملة. **نفس
    // انضباط النشر بالضبط**: هذا المفتاح يبقى `true` حتى يُتحقَّق أن العميل
    // المنشور يلغي عبر الدالة لا مباشرة، ثم يُقلب — لا قبل ذلك.
    //
    // ما يتأثر به: تحديث حالة الموعد إلى `Cancelled` من المريض مباشرة،
    // ونقص عدّاد الخانة المقابل. إعادة الجدولة (`rescheduleAppointment`)
    // لم يكن لها مسار عميل مباشر إطلاقاً — فلا حاجة لمفتاح توافقي لها.
    function clientDirectCancelEnabled() { return true; }

    // ===================== الطبيب القابل للحجز =====================

    // الحجز لا يُقبل إلا عند طبيب **موثَّق**.
    //
    // بدون هذا الشرط، أي حساب يُنشأ بدور طبيب (أو يُرقّى بالخطأ) يصبح فوراً
    // قابلاً لاستقبال مرضى حقيقيين ببياناتهم الصحية. التوثيق قرار إداري
    // يُكتب من Admin SDK، ولا يستطيع الطبيب منحه لنفسه (انظر
    // `keepsProtectedFields`).
    //
    // ملاحظة هجرة: الأطباء الموجودون قبل هذه المرحلة ليس لديهم الحقل، ولذلك
    // يجب تشغيل `scripts/grandfather_doctors.js` **قبل** نشر هذه القواعد،
    // وإلا توقّف الحجز عند كل طبيب قائم.
    function isBookableDoctor(doctorId) {
      let d = userData(doctorId);
      return d.role == 'doctor'
          && d.get('isVerified', false) == true
          // ===== المرحلة 9: إغلاق انحراف عن الخادم =====
          //
          // المرحلة 2 أضافت `disabled` وحدّثت `fetchBookableDoctor` في
          // `functions/availability.js` لتفحصه، لكن هذه الدالة بقيت على
          // شرطين. ومسار الحجز المباشر من العميل ما زال مفتوحاً
          // (`clientDirectBookingEnabled`)، فالفارق ليس نظرياً: عميل
          // معدَّل كان يُنشئ قفل خانة ثم موعداً عند طبيب أوقفته الإدارة،
          // فيسقط معنى الإيقاف كلّه — وهو الإجراء الوحيد المتاح للإدارة
          // حين يُساء استعمال حساب طبيب.
          //
          // `get('disabled', false)`: الأطباء السابقون للمرحلة 2 لا
          // يحملون الحقل، فغيابه يعني «غير موقوف» لا يعني الرفض.
          && d.get('disabled', false) != true;
    }

    // السعة المسموح بها لخانة هذا الطبيب، كما يعلنها مستنده هو — لا كما
    // يرسلها العميل.
    //
    // القيم الافتراضية مطابقة لما تستخدمه الواجهة عند غياب الحقل
    // (`patient_booking_screen.dart`)، حتى لا يفشل الحجز عند طبيب لم يكمل
    // إعداداته بعد.
    function allowedCapacity(doctorId) {
      let d = userData(doctorId);
      return d.get('bookingSystemType', 'Individual') == 'Grouped'
        ? d.get('maxPatientsPerSlot', 4)
        : 1;
    }

    // ===================== المستخدمون =====================

    match /users/{userId} {
      // ===== المرحلة 4: مُجمَّع التقييم صار خادمياً بالكامل =====
      //
      // كانت هنا `isReviewAggregateUpdate()` تسمح لأي مستخدم مسجَّل بتحديث
      // `rating` و`reviews` على مستند أي طبيب، شرط أن يزيد العدّاد بواحد
      // وأن تكون القيمة بين 0 و5. الشرطان لا يربطان التحديث بأي مراجعة
      // حقيقية: كان يكفي طلب `update` واحد — بلا زيارة ولا موعد ولا مراجعة —
      // لتحريك متوسط أي طبيب. وتكراره يهبط بتقييم منافس إلى الصفر.
      //
      // حُذفت القاعدة بالكامل. المتوسط لا يتغيّر الآن إلا داخل معاملة
      // `createReview` (راجع `functions/reviews.js`) التي تكتب المراجعة
      // والمُجمَّع معاً بـ Admin SDK — والقواعد لا تُطبَّق عليه.
      //
      // النتيجة: لا مسار عميل — مريضاً كان أو طبيباً أو حتى admin من التطبيق —
      // يستطيع لمس `rating` أو `reviews` أو `ratingSum`. الحماية في
      // `keepsProtectedFields()` أدناه تغطي صاحب الحساب، وغياب أي استثناء
      // يغطي الجميع.

      // الحقول التي لا يجوز للمستخدم تغييرها بنفسه.
      //
      // - `role`: بدونه يستطيع أي مريض ترقية نفسه إلى طبيب من العميل مباشرة،
      //   فيرى كل مواعيد العيادة وبيانات مرضاها.
      // - `isVerified`: وإلا وثّق الطبيب نفسه وسقطت قيمة التوثيق كلها.
      // - `email`: مفتاح الربط مع Firebase Auth ومع `phone_index`؛ تغييره من
      //   العميل يفصل الحساب عن وسيلة دخوله.
      // - `rating` و`reviews` و`ratingSum`: حقول مجمَّعة تُحسب من مراجعات
      //   المرضى. لو تُركت لصاحب الحساب لاستطاع الطبيب أن يكتب لنفسه 5 نجوم
      //   و500 مراجعة. `ratingSum` (المرحلة 4) هو مجموع النجوم كعدد صحيح —
      //   مصدر الحقيقة الذي يُشتق منه المتوسط بلا انجراف عائم.
      //   لا مسار عميل يكتب أياً منها؛ `createReview` وحدها.
      // - `disabled` و`verificationStatus` (المرحلة 2): هما ما يقرّر أهلية
      //   الحجز الفعلية (`fetchBookableDoctor` في `availability.js`) وحالة
      //   العرض في لوحة الإدارة. بدون حمايتهما يستطيع طبيب موقوف أن يعيد
      //   تفعيل نفسه بتحديث ملفه الشخصي مباشرة.
      // - بقية حقول دورة توثيق الطبيب (`verifiedAt/By`, `suspendedAt/By`,
      //   `suspensionReason`, `restoredAt/By`, `verificationSubmittedAt`):
      //   سجل تاريخي يكتبه `approveDoctor`/`suspendDoctor`/`restoreDoctor`
      //   وحدها — تزويره لا يغيّر الأهلية الفعلية، لكنه يفسد سجلاً إدارياً.
      //
      // `phone` غير محمي هنا عمداً: شاشة إعدادات الطبيب تسمح بتعديل الرقم،
      // ومنعه كان سيكسر ميزة قائمة. (مزامنة `phone_index` مسؤولية التطبيق.)
      function keepsProtectedFields() {
        return request.resource.data.role == resource.data.role
            && request.resource.data.get('isVerified', false)
               == resource.data.get('isVerified', false)
            && request.resource.data.get('email', '')
               == resource.data.get('email', '')
            && request.resource.data.get('rating', 0)
               == resource.data.get('rating', 0)
            && request.resource.data.get('reviews', 0)
               == resource.data.get('reviews', 0)
            && request.resource.data.get('ratingSum', 0)
               == resource.data.get('ratingSum', 0)
            && request.resource.data.get('disabled', false)
               == resource.data.get('disabled', false)
            && request.resource.data.get('verificationStatus', '')
               == resource.data.get('verificationStatus', '')
            && request.resource.data.get('verifiedAt', null)
               == resource.data.get('verifiedAt', null)
            && request.resource.data.get('verifiedBy', '')
               == resource.data.get('verifiedBy', '')
            && request.resource.data.get('verificationSubmittedAt', null)
               == resource.data.get('verificationSubmittedAt', null)
            && request.resource.data.get('suspendedAt', null)
               == resource.data.get('suspendedAt', null)
            && request.resource.data.get('suspendedBy', '')
               == resource.data.get('suspendedBy', '')
            && request.resource.data.get('suspensionReason', '')
               == resource.data.get('suspensionReason', '')
            && request.resource.data.get('restoredAt', null)
               == resource.data.get('restoredAt', null)
            && request.resource.data.get('restoredBy', '')
               == resource.data.get('restoredBy', '');
      }

      // القراءة: صاحب الحساب يقرأ مستنده. الأطباء بحاجة لأن يكونوا مرئيين
      // للمرضى حتى يمكن حجز المواعيد، ولذلك يُسمح لأي مستخدم مسجَّل بقراءة
      // مستندات الأطباء فقط — لا مستندات المرضى.
      allow read: if isUser(userId)
                  || (isSignedIn() && resource.data.role == 'doctor');

      // الإنشاء: عند التسجيل فقط، وبمعرّف يطابق حساب المصادقة، **وبدور
      // مريض حصراً**.
      //
      // كانت القاعدة تقبل `role in ['doctor', 'patient']`، وشاشة التسجيل
      // تعرض الخيارين للجميع — أي أن أي شخص يسجّل نفسه طبيباً بضغطة زر،
      // فيظهر في قائمة الأطباء ويستقبل حجوزات ويقرأ أعراض المرضى.
      //
      // حسابات الأطباء تُنشأ الآن من Admin SDK وحده:
      //   node scripts/promote_to_doctor.js --uid=<uid> --apply
      // ===== المرحلة 9: الحقول الخادمية محميّة عند الإنشاء أيضاً =====
      //
      // كانت `keepsProtectedFields()` تحرس **التحديث** وحده، فبقي باب
      // مفتوح عند الإنشاء: يكتب المستخدم مستنده الأول بما يشاء من الحقول
      // المجمَّعة. والمسار مكتمل لا نظري:
      //
      //   يسجّل بـ `rating: 5, reviews: 500, ratingSum: 2500`
      //     → يتقدّم بطلب طبيب
      //       → يوافق المدير (`approveDoctor` لا يصفّر المُجمَّع)
      //         → يظهر في البحث بخمس نجوم وخمسمئة مراجعة بلا زيارة واحدة.
      //
      // والتقييم هو ما يختار المريض عليه، فهذا التفافٌ كامل على سلطة
      // المراجعات التي بُنيت في المرحلة 4.
      //
      // ونفس الباب كان يقبل `verificationStatus: 'approved'` — حقل وصفي
      // تقرأه لوحة الإدارة و`doctorAccountStateFrom`، فيُظهر حالة كاذبة.
      //
      // الحلّ: الحقول التي لا يكتبها إلا الخادم يجب أن تكون **غائبة** عند
      // الإنشاء. الغياب لا الصفر: مستند جديد لا شأن له بها أصلاً.
      function noServerOwnedFieldsOnCreate() {
        return !request.resource.data.keys().hasAny([
          'rating', 'reviews', 'ratingSum',
          'disabled', 'verificationStatus',
          'verifiedAt', 'verifiedBy', 'verificationSubmittedAt',
          'suspendedAt', 'suspendedBy', 'suspensionReason',
          'restoredAt', 'restoredBy',
        ]);
      }

      allow create: if isUser(userId)
                    && request.resource.data.role == 'patient'
                    && request.resource.data.get('isVerified', false) == false
                    && noServerOwnedFieldsOnCreate();

      // صاحب الحساب وحده، وبلا مساس بالحقول المحمية. لا استثناء لأحد —
      // كل ما عدا ذلك يمرّ عبر دوال الخادم.
      // ===== المرحلة 6: حدود إعدادات العيادة =====
      //
      // الطبيب يملك تعديل `sessionDuration` و`maxPatientsPerSlot` و`price`،
      // وهي حقول تقرأها القواعد والخادم لبناء الخانات وسعتها
      // (`allowedCapacity` هنا، و`slotCapacity`/`slotDurationMinutes` في
      // `functions/availability.js`). الجانب السفلي محروس أصلاً — القيم
      // ≤ 0 تسقط إلى الافتراضي — لكن لا سقف عليها: `maxPatientsPerSlot`
      // بمليون يجعل قفل الخانة يقبل مليون معرّف مريض في مستند واحد.
      // التحقّق في الواجهة موجود لكنه ناقص (لا يفحص السعة في النمط الفردي
      // ولا المدة في الجماعي) وهو على العميل — أي ليس تفويضاً.
      //
      // تُفرض الحدود على الأرقام فقط: المستندات القديمة قد تحمل نصوصاً،
      // والخادم يعاملها أصلاً كقيمة غائبة فيسقط إلى الافتراضي.
      function inRange(field, low, high) {
        let v = request.resource.data.get(field, null);
        return !(v is number) || (v >= low && v <= high);
      }

      // `closedDates` أيام إغلاق مفردة، يقرأها محرّك الإتاحة
      // (`isClosedDate`). اتجاهها طرحي — تُنقص الإتاحة ولا تزيدها — فلا
      // ثابتة حجز تتأثر بها. الحدّ هنا على الحجم وحده: مصفوفة بلا سقف
      // تُضخّم مستند الطبيب الذي يُقرأ في كل استعلام إتاحة.
      function saneClosedDates() {
        let v = request.resource.data.get('closedDates', []);
        return !(v is list) || v.size() <= 366;
      }

      function sanePracticeSettings() {
        return inRange('sessionDuration', 5, 240)
            && inRange('maxPatientsPerSlot', 1, 50)
            && inRange('price', 0, 1000000)
            && saneClosedDates();
      }

      allow update: if isUser(userId)
                    && keepsProtectedFields()
                    && sanePracticeSettings();

      // الحذف ممنوع من العميل — يمر عبر Cloud Function حتى تُنظَّف
      // البيانات المرتبطة (المواعيد، الفهرس، التقييمات) معاً.
      allow delete: if false;
    }

    // ===================== طلبات توثيق الأطباء (المرحلة 2) =====================
    //
    // مستخدم عادي (role: patient) يتقدّم بطلب ليصبح طبيباً. الكتابة هنا لا
    // تمنح أي صلاحية طبيب بذاتها — `role` على `users/{uid}` يبقى `patient`
    // حتى يقبل الإدارة الطلب عبر `approveDoctor` (تعمل بـ Admin SDK، تتجاوز
    // هذه القواعد). معرّف المستند = معرّف المتقدّم، فطلب ثانٍ لنفس المستخدم
    // يعدّل نفس المستند بدل إنشاء طلب مواز — يحلّ التكرار ببساطة البنية لا
    // بمنطق إضافي.
    match /doctorApplications/{uid} {
      // الحقول الإدارية (`reviewedAt/By`, `rejectionReason`) لا تتغيّر بيد
      // صاحب الطلب — تُقارَن بـ `.get(field, null)` على الطرفين حتى لا تنهار
      // المقارنة عند غياب الحقل في طلب لم يُرفض بعد.
      function adminFieldsUnchanged() {
        return request.resource.data.get('reviewedAt', null)
                 == resource.data.get('reviewedAt', null)
            && request.resource.data.get('reviewedBy', null)
                 == resource.data.get('reviewedBy', null)
            && request.resource.data.get('rejectionReason', null)
                 == resource.data.get('rejectionReason', null);
      }

      function validApplicationFields() {
        return request.resource.data.uid == uid
            && request.resource.data.specialization is string
            && request.resource.data.specialization.size() > 0
            && request.resource.data.specialization.size() <= 200
            && request.resource.data.get('note', '') is string
            && request.resource.data.get('note', '').size() <= 1000
            && request.resource.data.keys().hasOnly([
                 'uid', 'status', 'specialization', 'note', 'submittedAt',
                 'reviewedAt', 'reviewedBy', 'rejectionReason'
               ]);
      }

      // صاحب الطلب يقرأ طلبه، والإدارة تقرأ كل الطلبات لمراجعتها.
      allow read: if isUser(uid) || isAdmin();

      // التقديم الأول: بحالة `pending` حصراً، ومعرّف يطابق صاحب الطلب، وبلا
      // أي حقل من حقول المراجعة الإدارية — طلب أول لم تنظر فيه الإدارة بعد
      // لا يجوز أن يولد ومعه سجل مراجعة أو سبب رفض جاهز.
      allow create: if isUser(uid)
                    && request.resource.data.status == 'pending'
                    && validApplicationFields()
                    && !('reviewedAt' in request.resource.data)
                    && !('reviewedBy' in request.resource.data)
                    && !('rejectionReason' in request.resource.data);

      // إعادة التقديم: فقط من حالة `pending` (تعديل نص الطلب قبل المراجعة)
      // أو `rejected` (تقديم جديد بعد رفض سابق) — وفي الحالتين إلى `pending`
      // مجدداً. لا يمسّ سجل المراجعة السابق.
      allow update: if isUser(uid)
                    && resource.data.status in ['pending', 'rejected']
                    && request.resource.data.status == 'pending'
                    && validApplicationFields()
                    && adminFieldsUnchanged();

      // لا حذف — يبقى سجل كل طلب، مقبولاً كان أو مرفوضاً.
      allow delete: if false;
    }

    // ===================== سجل تدقيق الإجراءات الإدارية (المرحلة 2) =====================
    //
    // append-only حصراً، ومن Admin SDK فقط — الدوال السحابية
    // (`approveDoctor`, `rejectDoctor`, `suspendDoctor`, `restoreDoctor`)
    // تكتب هنا مباشرة عبر Admin SDK، فتتجاوز هذه القواعد بطبيعتها. القاعدة
    // `allow write: if false` هنا ليست تكراراً بلا فائدة: هي ما يمنع أي عميل
    // — حتى مدير — من كتابة سجل مزوَّر أو تعديل/حذف سجل موجود.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ===================== فهرس أرقام الجوال =====================

    // يحتوي على الحد الأدنى المطلوب لتسجيل الدخول بالرقم: البريد والمعرّف.
    // القراءة مفتوحة لأنها تحدث *قبل* المصادقة بالضرورة، لكن معرّف المستند هو
    // رقم الجوال نفسه — فلا يمكن تصفّح المجموعة أو استخراج قائمة بها، ولا بد
    // من معرفة الرقم مسبقاً للوصول لأي مدخل.
    match /phone_index/{phone} {
      // المدخل يجب أن يشير إلى بريد صاحب الطلب نفسه، لا إلى بريد يختاره.
      // بدون هذا الشرط يستطيع مستخدم كتابة مدخل يوجّه رقماً إلى بريد ثالث.
      function pointsToCaller() {
        return request.resource.data.uid == request.auth.uid
            && request.resource.data.email == request.auth.token.email;
      }

      allow get: if true;
      allow list: if false;      // منع سحب الفهرس كاملاً.

      allow create: if isSignedIn()
                    && pointsToCaller()
                    && request.resource.data.keys()
                         .hasOnly(['uid', 'email', 'createdAt']);

      // التعديل لصاحب المدخل القائم فقط — الشرط على `resource` وليس
      // `request.resource`.
      //
      // الفرق ليس شكلياً: لو كان الشرط على `request.resource` لاستطاع أي
      // مستخدم أن يكتب فوق مدخل رقم شخص آخر ويوجّهه لبريده هو، فيمنع صاحب
      // الرقم الحقيقي من تسجيل الدخول (تعطيل حساب).
      allow update: if isSignedIn()
                    && resource.data.uid == request.auth.uid
                    && pointsToCaller();

      allow delete: if false;
    }

    // ===================== أقفال الخانات الزمنية =====================

    // هذه المجموعة هي ما يمنع الحجز المزدوج فعلياً.
    //
    // لا يكفي أن يتحقق التطبيق من الامتلاء، لأن أي عميل معدَّل يستطيع تخطّي
    // ذلك الفحص. القواعد هنا تفرض الشرط على الخادم: العدّاد يزيد بواحد فقط،
    // ولا يتجاوز السعة، والسعة نفسها لا تُغيَّر بعد إنشاء الخانة.
    match /slots/{slotId} {
      // معرّف الخانة ليس اسماً حراً — هو دالة في (الطبيب، التاريخ، الوقت).
      //
      // بدون هذا الشرط يستطيع عميل معدَّل إنشاء خانة بمعرّف عشوائي تحمل نفس
      // بيانات خانة محجوزة، ثم يعلّق عليها موعداً — فيعود الحجز المزدوج من
      // باب خلفي رغم سلامة المعاملة الذرّية. الصيغة مطابقة لـ
      // `SlotId.forSlot` في `lib/core/utils/slot_id.dart`.
      function idMatchesFields() {
        return slotId == request.resource.data.doctorId + '_'
             + request.resource.data.appointmentDate + '_'
             + request.resource.data.startTime.replace(':', '-');
      }

      function validDateTimeFormat() {
        return request.resource.data.appointmentDate is string
            && request.resource.data.appointmentDate.matches('\\d{4}-\\d{2}-\\d{2}')
            && request.resource.data.startTime is string
            && request.resource.data.startTime.matches('\\d{2}:\\d{2}');
      }

      // المرحلة 1ج — تشديد أمني: ماذا يستطيع الطبيب فعلاً أن يفعل بخانته؟
      //
      // كانت القاعدة السابقة (`|| isUser(resource.data.doctorId)`) تمنح
      // الطبيب حرية **مطلقة** على أي حقل في الخانة: `bookedCount` لأي رقم
      // (بما فيه سالب أو أكبر من السعة)، و`patientIds` لأي قائمة (إضافة
      // مريض لم يحجز، حذف مريض حقيقي). أُثبت هذا فعلياً على المحاكي أثناء
      // بوابة التحقق قبل النشر: `bookedCount: 999` على خانة سعتها 1 نجحت،
      // وكذلك `bookedCount: -5`، وكذلك حقن `patientIds: ['شخص لم يحجز']`.
      // القيمة السالبة تحديداً تفتح حجزاً مضاعفاً فعلياً: خانة سعتها 1
      // بـ bookedCount = -5 تقبل ستة حجوزات متتالية قبل أن يعود العدّاد
      // فوق الصفر — نقض مباشر لضمان «لا حجز مضاعف أبداً».
      //
      // فحص الكود الفعلي (`grep` على `lib/` كاملة) يُثبت أن مكاناً واحداً
      // فقط يكتب على `slots`: `BookingService.cancelAsDoctor`، وشكل كتابته
      // ثابت دائماً: إنقاص `bookedCount` بواحد بالضبط (بحد أدنى صفر)، وحذف
      // مريض واحد بعينه من `patientIds` — تماماً كما يفعل فرع إلغاء المريض
      // نفسه أعلاه، لكن الطبيب يملك حذف أيٍّ من مرضاه لا نفسه فقط. لا توجد
      // شاشة طبيب تنشئ خانة أو تغلقها أو تحذفها — «الحقول التي يديرها
      // الطبيب» (ساعات العمل، أيام العمل، مدة الكشف) كلها على مستند
      // `users/{doctorId}`، لا على `slots` إطلاقاً.
      //
      // الشرط هنا نسخة طبق الأصل من انضباط فرع إلغاء المريض، معمَّم لأي
      // مريض بدل صاحب الطلب وحده، مع مطابقة صريحة لسلوك `.clamp(0, ...)`
      // في الكود: لو كان العدّاد صفراً بالفعل (حالة تكرار إلغاء نادرة) فهو
      // يبقى صفراً بدل أن يصبح سالباً.
      function doctorRemovesOnePatient() {
        let oldCount = resource.data.bookedCount;
        let newCount = request.resource.data.bookedCount;
        let oldPatients = resource.data.patientIds;
        let newPatients = request.resource.data.patientIds;
        return isUser(resource.data.doctorId)
            && newCount == (oldCount > 0 ? oldCount - 1 : 0)
            && newCount >= 0
            // لا إضافة: كل عنصر في القائمة الجديدة كان موجوداً في القديمة.
            && oldPatients.hasAll(newPatients)
            // حذف مريض واحد بالضبط، أو لا حذف فعلي (حالة العدّاد الصفري
            // المتكرر أعلاه، حيث لم يكن المريض موجوداً أصلاً فتبقى القائمة
            // كما هي).
            && (oldPatients.size() == newPatients.size() + 1
                || oldPatients.size() == newPatients.size());
      }

      // ===== المرحلة 9 — تقليل البيانات =====
      //
      // مستند الخانة يحمل `patientIds`، أي ربطاً طبياً صريحاً: مَن حجز عند
      // أي طبيب في أي وقت. والطبيب يعلن تخصصه، فالربط وحده يكشف طبيعة
      // الحالة. القاعدة السابقة كانت `allow read: if isSignedIn()`، و`read`
      // تشمل `list` — أي أن أي حساب مسجَّل (يُنشأ في ثوانٍ) كان يستطيع سحب
      // المجموعة كاملة باستعلام واحد. أُثبت ذلك على المحاكي قبل هذا التشديد.
      //
      // لا شاشة في التطبيق تستعلم `slots` إطلاقاً: التوافر يأتي من
      // `getAvailability` وهي لا تُرجع `patientIds`، والقراءة المباشرة
      // الوحيدة في `lib/` هي `BookingService.cancelAsDoctor` — قراءة مستند
      // واحد بمعرّفه داخل معاملة. فإقفال `list` لا يكسر أي مسار قائم.
      allow list: if false;

      // `get` يبقى متاحاً للمسجَّلين **ما دام مفتاح الحجز المباشر مفتوحاً**:
      // العميل المنشور القديم يقرأ القفل داخل معاملة الحجز، فتقييد القراءة
      // الآن يكسر الحجز في الخانات الجماعية (مَن يحجز ثانياً ليس بعدُ في
      // `patientIds`). حين يُقلب المفتاح — وهو انضباط النشر المكتوب أعلاه —
      // يضيق `get` تلقائياً إلى صاحب الخانة ومَن فيها، دون تعديل لاحق.
      //
      // خطر متبقٍّ معلَن حتى ذلك الحين: مَن يعرف معرّف الخانة (وهو مشتقّ من
      // الطبيب والتاريخ والوقت) يستطيع قراءة `patientIds` مستنداً مستنداً.
      // الكشف الجماعي أُغلق؛ الكشف المستهدف لا يُغلق إلا بقلب المفتاح.
      allow get: if isSignedIn()
                 && (
                   clientDirectBookingEnabled()
                   // الخانة غير الموجودة لا تكشف شيئاً، وقراءتها جزء من
                   // معاملة الإلغاء (موعد قديم قُفلت خانته أو حُذفت).
                   || resource == null
                   || isUser(resource.data.doctorId)
                   || request.auth.uid in resource.data.patientIds
                 );

      allow create: if clientDirectBookingEnabled()
                    && isSignedIn()
                    && request.resource.data.bookedCount == 1
                    && request.resource.data.patientIds.size() == 1
                    && request.resource.data.patientIds[0] == request.auth.uid
                    && request.resource.data.doctorId is string
                    && validDateTimeFormat()
                    && idMatchesFields()
                    && isBookableDoctor(request.resource.data.doctorId)
                    // السعة تُملى من مستند الطبيب، لا من العميل. كانت
                    // القاعدة تقبل أي `capacity >= 1`، أي أن أول من يحجز
                    // خانة يستطيع أن يجعل سعتها 999 ويُغرق عيادة الطبيب.
                    && request.resource.data.capacity
                       == allowedCapacity(request.resource.data.doctorId);

      allow update: if isSignedIn()
                    && unchanged('capacity')
                    && unchanged('doctorId')
                    && unchanged('appointmentDate')
                    && unchanged('startTime')
                    && (
                      // حجز: زيادة بواحد دون تجاوز السعة، ويضيف صاحب الطلب
                      // نفسه فقط — لا يحذف غيره ولا يضيف أحداً سواه.
                      (
                        clientDirectBookingEnabled()
                        && request.resource.data.bookedCount == resource.data.bookedCount + 1
                        && request.resource.data.bookedCount <= resource.data.capacity
                        && !(request.auth.uid in resource.data.patientIds)
                        && request.resource.data.patientIds.hasAll([request.auth.uid])
                        && request.resource.data.patientIds.hasOnly(
                             resource.data.patientIds.concat([request.auth.uid]))
                      )
                      // إلغاء: نقص بواحد، ولا يقل عن الصفر، **ولصاحب الحجز
                      // وحده**.
                      //
                      // كانت هذه الفقرة بلا أي تحقق من الهوية: أي مستخدم
                      // مسجَّل يستطيع إنقاص عدّاد أي خانة، فتبدو متاحة
                      // ويُحجز فوقها، أو يُحرم صاحبها من مكانه.
                      //
                      // الشرطان الأخيران يجعلان القائمة الجديدة **مساوية**
                      // للقديمة ناقص صاحب الطلب: لا يضيف أحداً، ولا يشطب
                      // مريضاً آخر من خانة مجموعة ليُخلي له مكاناً.
                      || (
                        clientDirectCancelEnabled()
                        && request.resource.data.bookedCount == resource.data.bookedCount - 1
                        && request.resource.data.bookedCount >= 0
                        && request.auth.uid in resource.data.patientIds
                        && !(request.auth.uid in request.resource.data.patientIds)
                        && resource.data.patientIds.hasAll(
                             request.resource.data.patientIds)
                        && request.resource.data.patientIds.hasAll(
                             resource.data.patientIds.removeAll([request.auth.uid]))
                      )
                      // الطبيب يلغي حجز أحد مرضاه من شاشة جدوله — راجع
                      // `doctorRemovesOnePatient()` أعلاه لماذا هذا الشكل
                      // تحديداً لا حرية مطلقة.
                      || doctorRemovesOnePatient()
                    );

      // الحذف مقيَّد بخانة فارغة فعلاً. لا مسار في التطبيق يحذف خانة
      // إطلاقاً اليوم (`grep` على `lib/` كاملة لا يُظهر أي استدعاء حذف على
      // `slots`)، فهذا القيد لا يكسر شيئاً قائماً؛ هدفه إغلاق الباب أمام
      // اختفاء خانة عليها حجوزات فعلية دون المرور بإلغائها أولاً.
      allow delete: if isUser(resource.data.doctorId)
                    && resource.data.bookedCount == 0;
    }

    // ===================== المواعيد =====================

    match /appointments/{appointmentId} {
      function isPatientOwner() {
        return isUser(resource.data.patientId);
      }

      function isDoctorOwner() {
        return isUser(resource.data.doctorId);
      }

      // الموعد لا يقوم بذاته: لا بد أن يقابله قفل خانة يحمل نفس الطبيب ونفس
      // التاريخ ونفس الوقت، ويحتوي صاحب الطلب.
      //
      // `getAfter` وليس `get`: القفل والموعد يُكتبان في **نفس المعاملة**
      // (`BookingService.book`)، فحالة الخانة قبل المعاملة قد تكون غير
      // موجودة أصلاً عند أول حجز. `getAfter` تقرأ الحالة بعد اكتمال
      // المعاملة، وهي الأداة المخصّصة لهذا بالضبط.
      //
      // بدون هذا الشرط كانت قاعدة الإنشاء تقبل أي مستند موعد بحالة `Booked`
      // دون أي علاقة بالخانات — أي أن ضمان عدم الحجز المزدوج كان قابلاً
      // للتخطي بكتابة مباشرة من عميل معدَّل، والطبيب يرى الموعد في جدوله
      // لأن الجدول يُقرأ من `appointments` لا من `slots`.
      function backedBySlot() {
        let slot = getAfter(
          /databases/$(database)/documents/slots/$(request.resource.data.slotId)
        ).data;
        return slot.doctorId == request.resource.data.doctorId
            && slot.appointmentDate == request.resource.data.appointmentDate
            && slot.startTime == request.resource.data.startTime
            && slot.patientIds.hasAll([request.auth.uid])
            && slot.bookedCount <= slot.capacity;
      }

      // المريض يرى مواعيده، والطبيب يرى المواعيد المحجوزة عنده فقط.
      allow read: if isPatientOwner() || isDoctorOwner();

      // الحجز: المريض يكتب باسمه هو، بحالة ابتدائية `Booked` فقط.
      // منع تعيين حالة أخرى يمنع مريضاً من تسجيل نفسه "مكتمل" لتفادي رسوم
      // أو للتلاعب بإحصاءات الطبيب.
      //
      // معرّف المستند مقيَّد بـ `{slotId}__{patientId}` (مطابق لـ
      // `SlotId.forAppointment`) حتى لا يستطيع مريض تعليق عدة مستندات مواعيد
      // على قفل واحد بمعرّفات عشوائية.
      allow create: if clientDirectBookingEnabled()
                    && isUser(request.resource.data.patientId)
                    && request.resource.data.status == 'Booked'
                    && request.resource.data.doctorId is string
                    && request.resource.data.appointmentDate is string
                    && request.resource.data.startTime is string
                    && request.resource.data.slotId is string
                    && appointmentId
                       == request.resource.data.slotId + '__' + request.auth.uid
                    && isBookableDoctor(request.resource.data.doctorId)
                    && backedBySlot();

      // التحديث مقسوم حسب الدور.
      //
      // كانت قاعدة واحدة تسمح للطرفين بتغيير **كل شيء** عدا الطبيب والمريض
      // والتاريخ والوقت. عملياً كان المريض يستطيع أن يعلّم موعده `Completed`،
      // أو يصفّر `price`، أو يكتب فوق `notes` — وهي الملاحظة الطبية التي
      // يكتبها الطبيب، أي تعديل سجل طبي.

      // المريض: الإلغاء وحده، وفقط عبر المسار المباشر القديم.
      //
      // المرحلة 1ب نقلت الإلغاء إلى `cancelAppointment` (تحقّق من الحالة
      // والمهلة، وتحرير الخانة في نفس المعاملة). الدالة تعمل بـ Admin SDK
      // فتتجاوز هذه القاعدة أصلاً؛ القاعدة هنا للتوافق مع نسخ تطبيق قديمة
      // لم تُحدَّث بعد — وتُقفَل بعد التحقق، بنفس انضباط `clientDirectBookingEnabled()`.
      allow update: if isPatientOwner()
                    && clientDirectCancelEnabled()
                    && changedKeys().hasOnly(['status', 'cancelledAt'])
                    && request.resource.data.status == 'Cancelled';

      // الطبيب: الحالة والملاحظة الطبية.
      //
      // `cancelledBy` مضافة للمرحلة 1ب: `BookingService.cancelAsDoctor`
      // تكتبها لتمييز إلغاء الطبيب عن إلغاء المريض في السجل (راجع تعليق
      // تلك الدالة). حقل تصنيف لا بيانات حسّاسة، ولا يفتح شيئاً لم يكن
      // الطبيب يملكه أصلاً — فهو أصلاً يملك تغيير `status` إلى `Cancelled`.
      // ===== المرحلة 9: الحالات النهائية نهائية =====
      //
      // كانت القاعدة تفحص قيمة الحالة الجديدة ولا تنظر إلى الحالية، فكان
      // الطبيب ينقل موعداً **ملغى** إلى `Booked`. والإلغاء يكون قد حرّر
      // قفل الخانة، فينتج موعد يشغل وقتاً لا قفل يقابله — وهو بعينه
      // «موعد بلا خانة» الذي أُغلق في المرحلة صفر، عائداً من جهة التحديث
      // لا الإنشاء. ويمكن عندئذ لمريض آخر أن يحجز نفس الوقت.
      //
      // وكذلك `Completed` → `Booked`: يمحو سجل زيارة وقعت فعلاً، وعليها
      // بُنيت أهلية المراجعة والإحصاءات.
      //
      // القاعدة الآن: لا خروج من حالة نهائية إلى حالة نشطة. والتصحيح بين
      // الحالات النهائية يبقى متاحاً (مكتمل ↔ لم يحضر) لأنه تصحيح سريري
      // مشروع لا إحياء لموعد.
      function isTerminalStatus(value) {
        return value in ['Completed', 'Cancelled', 'NoShow'];
      }

      function isActiveStatus(value) {
        return value in ['Booked', 'PendingConfirmation'];
      }

      allow update: if isDoctorOwner()
                    && changedKeys().hasOnly(
                         ['status', 'notes', 'cancelledAt', 'cancelledBy',
                          'completedAt', 'updatedAt'])
                    && (
                      !('status' in changedKeys())
                      || (
                        request.resource.data.status in
                          ['Booked', 'Completed', 'Cancelled', 'NoShow',
                           'PendingConfirmation']
                        && !(
                          isTerminalStatus(resource.data.status)
                          && isActiveStatus(request.resource.data.status)
                        )
                      )
                    );

      // لا حذف — الإلغاء يتم بتغيير الحالة، حتى يبقى سجل العيادة كاملاً.
      allow delete: if false;
    }

    // ===================== التقييمات التفصيلية =====================

    // مجموعة `ratings` تحمل تقييمين مختلفين تماماً في الحساسية:
    //   - `patient_to_doctor`: تقييم المريض لجودة الخدمة.
    //   - `doctor_to_patient`: تقييم الطبيب للحالة الصحية للمريض — **بيانات
    //     طبية**، لا يجوز أن يقرأها أحد غير المريض والطبيب الذي كتبها.
    //
    // الحقول هنا `fromUserId` و`toUserId` و`ratingType` مطابقةً لـ
    // `lib/data/models/rating_model.dart`.
    match /ratings/{ratingId} {
      // ===== المرحلة 6: إصلاح أمني =====
      //
      // كانت قاعدة الإنشاء تشترط شيئين فقط: أن يكون الكاتب مسجَّلاً، وألّا
      // ينتحل `fromUserId`. أي أن **أي مستخدم مسجَّل** كان يستطيع كتابة
      // مستند `doctor_to_patient` — أي تقييم للحالة الصحية لمريض — باسمه
      // هو، موجَّهاً إلى أي `toUserId` يختاره، بلا إثبات أنه طبيب ولا أنّ
      // بينه وبين ذلك المستخدم أي موعد. القراءة محصورة بالطرفين، فالتسريب
      // ليس هو الخطر؛ الخطر أن يصل إلى مستخدم مستندٌ يبدو ملاحظةً طبية
      // كتبها «طبيبه».
      //
      // العلاقة العلاجية ليست مخترعة هنا: مستند التقييم يحمل أصلاً
      // `appointmentId` (انظر `lib/data/models/rating_model.dart`)، ومستند
      // الموعد يحمل `doctorId` و`patientId` كما يكتبهما الخادم
      // (`functions/booking.js`). فالتحقّق يتم بالموعد الحقيقي نفسه.
      //
      // ملاحظة نطاق: هذا إغلاق للثغرة فقط. منظومة `ratings` تبقى غير موصولة
      // بأي واجهة، ولم تُوسَّع (انظر رؤوس ملفاتها).

      // الموعد الذي يدّعي هذا التقييم أنه ناتج عنه.
      function ratedAppointment() {
        return get(/databases/$(database)/documents/appointments/
                   $(request.resource.data.appointmentId)).data;
      }

      // الكاتب طبيب فعلاً بحسب مستنده هو، لا بحسب ما يرسله.
      //
      // `disabled` وليس `isVerified`: الطبيب الموقوف هو تحديداً الحساب الذي
      // قرّر المدير إيقافه، فلا يكتب ملاحظات طبية جديدة. أما `isVerified`
      // فلا يُشترط هنا لأن الأطباء السابقين للمرحلة 2 قد لا يحملونه، ولا
      // يمكن أن يوجد لهم موعد أصلاً بغير توثيق (`isBookableDoctor`).
      function writerIsDoctor() {
        let d = userData(request.auth.uid);
        return d.role == 'doctor' && d.get('disabled', false) != true;
      }

      // الطرفان مطابقان لطرفَي الموعد، كلٌّ في اتجاهه الصحيح.
      function partiesMatchAppointment() {
        let appt = ratedAppointment();
        let from = request.resource.data.fromUserId;
        let to = request.resource.data.toUserId;
        return request.resource.data.ratingType == 'doctor_to_patient'
          ? (writerIsDoctor() && appt.doctorId == from && appt.patientId == to)
          : (appt.patientId == from && appt.doctorId == to);
      }

      // تقييم المريض للخدمة لا يحمل حقولاً صحّية — وإلا صار بابَ تسريبٍ
      // معكوس: مستند «طبي» كتبه غير طبيب.
      function healthFieldsOnlyFromDoctor() {
        return request.resource.data.ratingType == 'doctor_to_patient'
          || !request.resource.data.keys().hasAny(
               ['healthConditionRating', 'healthConditionComment']);
      }

      allow read: if isSignedIn() && (
                    isUser(resource.data.fromUserId)
                    || isUser(resource.data.toUserId)
                  );

      allow create: if isSignedIn()
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.ratingType in
                       ['doctor_to_patient', 'patient_to_doctor']
                    && request.resource.data.appointmentId is string
                    && partiesMatchAppointment()
                    && healthFieldsOnlyFromDoctor();

      // `ratingType` و`appointmentId` مثبَّتان أيضاً: بدونهما يستطيع مريضٌ
      // كتب تقييم خدمة مشروعاً أن يحوّله بالتعديل إلى `doctor_to_patient`
      // على موعد آخر — فيلتفّ على قاعدة الإنشاء كلها. الطرفان وحدهما لا
      // يكفيان لأنهما يبقيان كما هما في هذا الالتفاف.
      allow update: if isSignedIn()
                    && isUser(resource.data.fromUserId)
                    && unchanged('fromUserId')
                    && unchanged('toUserId')
                    && unchanged('ratingType')
                    && unchanged('appointmentId')
                    && healthFieldsOnlyFromDoctor();

      allow delete: if isSignedIn() && isUser(resource.data.fromUserId);
    }

    // ===================== مراجعات الأطباء العلنية =====================

    // مجموعة منفصلة يكتبها المريض من شاشة "مواعيدي" (نجوم + تعليق).
    // القراءة متاحة لكل مستخدم مسجَّل لأنها جزء من اختيار الطبيب.
    match /reviews/{reviewId} {
      // ===== المرحلة 4: الكتابة من الخادم وحده =====
      //
      // كانت القواعد هنا تتحقق بنفسها من الزيارة المكتملة (`get` على مستند
      // الموعد)، وتسمح للمريض بالإنشاء والتعديل والحذف مباشرة. ذلك أغلق باب
      // «مراجعة بلا زيارة»، لكنه ترك ثلاث فجوات لا تستطيع القواعد سدّها:
      //
      //   1. **لا ذرّية.** المراجعة تُكتب هنا، ومتوسط الطبيب يُحدَّث بطلب
      //      منفصل. انقطاع بينهما يترك أحدهما بلا الآخر.
      //   2. **المتوسط يُحسب على العميل** ويُرسل كقيمة نهائية.
      //   3. **إعادة الإرسال ترفع العدّاد مرتين**: `set` يستبدل المراجعة
      //      بلا أثر، بينما معاملة المُجمَّع تُنفَّذ من جديد.
      //
      // الآن `createReview` (Admin SDK، فلا تُطبَّق عليها هذه القواعد) تكتب
      // المراجعة والمُجمَّع في معاملة واحدة، وتشتقّ المريض والطبيب من مستند
      // الموعد نفسه. فلا حاجة لأي مسار كتابة من العميل — وإبقاؤه مفتوحاً
      // يعني بابين لنفس الغرض، أضعفهما هو الذي سيُستخدم للتحايل.
      //
      // القراءة تبقى متاحة لكل مستخدم مسجَّل: المراجعات جزء من اختيار
      // الطبيب. ما يُكتب في المستند لا يحوي هاتفاً ولا بريداً ولا ملاحظات
      // طبية — الاسم المعروض والتقييم والتعليق فقط (`functions/reviews.js`).
      allow read: if isSignedIn();

      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ===================== الإشعارات =====================

    match /notifications/{notificationId} {
      // المرسَل إليه فقط. `recipientId` هو الحقل القياسي منذ المرحلة 3
      // (`functions/notifications.js`)؛ الثلاثة الأخرى تغطّي مستندات قديمة
      // بصيغ سابقة (`userId`/`patientId`/`doctorId`) لا تزال قابلة للقراءة.
      function isRecipient() {
        return isUser(resource.data.get('recipientId', ''))
            || isUser(resource.data.get('userId', ''))
            || isUser(resource.data.get('patientId', ''))
            || isUser(resource.data.get('doctorId', ''));
      }

      allow read: if isRecipient();

      // الإنشاء من الخادم فقط (Cloud Functions تتجاوز هذه القواعد، وتكتب
      // من `queueNotification`/`createReminderIfAbsent`). لولا ذلك لاستطاع
      // أي مستخدم إرسال إشعارات باسم العيادة، أو انتحال صفة مُرسِل.
      allow create: if false;

      // للمستلم أن يعلّمها كمقروءة، لا أكثر — لا `recipientId`، ولا
      // `type`، ولا `body`، ولا `appointmentId`، ولا `createdAt`. الحقلان
      // القديم (`read`) والجديد (`isRead`/`readAt`) مقبولان معاً للتوافق.
      allow update: if isRecipient()
                    && changedKeys().hasOnly(['read', 'isRead', 'readAt']);

      allow delete: if isRecipient();
    }

    // ===================== أجهزة المستخدم (رموز Push) =====================

    // `users/{uid}/devices/{deviceId}` — معرّف كل مستند هو رمز FCM نفسه،
    // فتسجيل نفس الجهاز مرتين يستبدل لا يكرّر. المسار نفسه (`{userId}`
    // جزء من مسار المستند لا حقل داخله) هو ما يمنع تسجيل رمز باسم مستخدم
    // آخر أو الكتابة فوق رمز صاحبه — لا حاجة لفحص هوية إضافي داخل الحقول.
    // القراءة من الخادم عبر Admin SDK فقط (تسليم Push)، فلا قاعدة قراءة
    // إضافية له هنا.
    match /users/{userId}/devices/{deviceId} {
      allow read: if isUser(userId);

      allow create, update: if isUser(userId)
                            && request.resource.data.token is string
                            && request.resource.data.token.size() > 0
                            && request.resource.data.platform in ['android', 'ios', 'web'];

      allow delete: if isUser(userId);
    }

    // ===================== الافتراضي =====================

    // أي مجموعة لم تُذكر أعلاه مغلقة تماماً — ومنها `otps` التي حُذفت في
    // المرحلة صفر: كانت `allow create: if true` بلا مصادقة، ودالة سحابية
    // ترسل بريداً إلى عنوان مأخوذ من معرّف المستند، أي مرحّل بريد مفتوح
    // باسم المشروع. المسار لم يكن مستخدماً في التطبيق أصلاً.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
