# Firebase Functions Environment Variables
# Copy these and set them using: firebase functions:config:set

# Gmail Configuration
# 1. Generate App Password from: https://myaccount.google.com/security
# 2. Use: firebase functions:config:set gmail.user="your-email@gmail.com" gmail.password="your-app-password"

# Example:
# firebase functions:config:set gmail.user="doctor.heldoc@gmail.com" gmail.password="abcd efgh ijkl mnop"

# After setting, deploy:
# firebase deploy --only functions
