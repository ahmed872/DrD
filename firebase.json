{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.local"]
    }
  ],
  "hosting": {
    "//site": "اسم موقع الاستضافة — يحدّد الرابط: https://<site>.web.app. عند حذفه يُستخدم اسم المشروع (heldoc-68abf.web.app). لتغيير الرابط: أنشئ الموقع أولاً بـ `firebase hosting:sites:create <اسم>` ثم اكتب الاسم في المفتاح `site` أسفله. الاسم فريد عالمياً عبر كل مشاريع Firebase.",
    "site": "drd-clinic",
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "//": "عامل الخدمة و index.html يجب ألا يُخزَّنا مؤقتاً، وإلا بقي المستخدم على نسخة قديمة من التطبيق إلى الأبد.",
        "source": "/@(index.html|flutter_service_worker.js|service_worker_extras.js)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "//": "ملفات البناء تحمل بصمة في اسمها، فتخزينها لسنة كاملة آمن ويجعل الإقلاع فورياً.",
        "source": "**/*.@(js|wasm|css|png|jpg|jpeg|svg|webp|woff2|ttf|otf|json)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "//": "manifest.json مستثنى من القاعدة السابقة لأنه يتغير مع كل تحديث لبيانات التطبيق.",
        "source": "/manifest.json",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "//": "رؤوس أمان أساسية.",
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true }
  }
}
